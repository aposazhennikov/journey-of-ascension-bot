 "categories": {
  "luo": {
   "i18n": {
    "ru": {
     "name": "ЛО-пункт",
     "short": "Соединительная точка: отсюда отходит ветвь к парному меридиану. На карте видно, куда она ведёт, и можно проследить, как внимание переходит с одной линии на другую."
    },
    "en": {
     "name": "Luo (connecting) point",
     "short": "A connecting point: a branch runs from here to the paired meridian. The map shows where it leads, so you can follow attention as it moves from one line to the other."
    },
    "uz": {
     "name": "Lo-nuqta (bog'lovchi)",
     "short": "Bog'lovchi nuqta: bu yerdan juft meridianga tarmoq ketadi. Xaritada u qayerga olib borishi ko'rinadi, diqqat bir chiziqdan ikkinchisiga qanday o'tishini kuzatish mumkin."
    },
    "kz": {
     "name": "Ло-нүкте (байланыстырушы)",
     "short": "Байланыстырушы нүкте: осыдан жұп меридианға тармақ кетеді. Картада оның қайда апаратыны көрінеді, зейіннің бір сызықтан екіншісіне қалай өтетінін бақылауға болады."
    }
   },
   "color_hint": "#E4572E"
  },
  "great_luo": {
   "i18n": {
    "ru": {
     "name": "Большой ЛО-пункт",
     "short": "Большой соединительный пункт селезёнки сбоку на груди. По традиции отсюда сеть мелких сосудов расходится по всей грудной клетке и бокам."
    },
    "en": {
     "name": "Great luo point",
     "short": "The great connecting point of the spleen, on the side of the chest. Traditionally, a net of small vessels spreads from here across the whole chest and flanks."
    },
    "uz": {
     "name": "Katta Lo-nuqta",
     "short": "Taloqning katta bog'lovchi nuqtasi, ko'krakning yon tomonida. An'anaga ko'ra bu yerdan mayda tomirlar to'ri butun ko'krak qafasi va biqinlar bo'ylab tarqaladi."
    },
    "kz": {
     "name": "Үлкен Ло-нүкте",
     "short": "Көкбауырдың үлкен байланыстырушы нүктесі, кеуденің бүйір жағында. Дәстүр бойынша осыдан ұсақ тамырлар торы бүкіл кеуде мен бүйірлерге таралады."
    }
   },
   "color_hint": "#B83B1D"
  },
  "yuan": {
   "i18n": {
    "ru": {
     "name": "Точка-источник (юань)",
     "short": "Точка-источник: по традиции здесь яснее всего проявляется сам меридиан. Хорошее место, чтобы задержать внимание и почувствовать линию целиком."
    },
    "en": {
     "name": "Yuan (source) point",
     "short": "The source point: traditionally, this is where the meridian shows itself most clearly. A good place to rest attention and sense the whole line."
    },
    "uz": {
     "name": "Yuan-nuqta (manba)",
     "short": "Manba nuqtasi: an'anaga ko'ra meridian aynan shu yerda eng aniq namoyon bo'ladi. Diqqatni to'xtatib, butun chiziqni his qilish uchun qulay joy."
    },
    "kz": {
     "name": "Юань-нүкте (бастау)",
     "short": "Бастау нүктесі: дәстүр бойынша меридиан дәл осы жерде ең анық білінеді. Зейінді тоқтатып, бүкіл сызықты сезінуге ыңғайлы орын."
    }
   },
   "color_hint": "#F3A712"
  },
  "xi": {
   "i18n": {
    "ru": {
     "name": "СИ-пункт",
     "short": "Щелевая точка: здесь энергия меридиана собирается глубже, как вода в расщелине. Ощущения в ней нередко отчётливее, чем по соседству."
    },
    "en": {
     "name": "Xi (cleft) point",
     "short": "The cleft point: here the meridian's energy gathers deeper, like water in a crevice. Sensations here are often more distinct than in the surrounding area."
    },
    "uz": {
     "name": "Si-nuqta (yoriq)",
     "short": "Yoriq nuqtasi: bu yerda meridian energiyasi yoriqdagi suvdek chuqurroq to'planadi. Bu yerdagi sezgilar ko'pincha atrofdagidan aniqroq bo'ladi."
    },
    "kz": {
     "name": "Си-нүкте (саңылау)",
     "short": "Саңылау нүктесі: мұнда меридиан энергиясы жарықтағы судай тереңірек жиналады. Мұндағы сезімдер көбіне айналасындағыдан анығырақ болады."
    }
   },
   "color_hint": "#8E44AD"
  },
  "jing_well": {
   "i18n": {
    "ru": {
     "name": "Точка-колодец (цзин)",
     "short": "Крайняя точка меридиана у кончика пальца, где канал выходит на поверхность или уходит с неё. С неё удобно начинать или заканчивать прохождение линии вниманием."
    },
    "en": {
     "name": "Jing-well point",
     "short": "The outermost point of the meridian at the tip of a finger or toe, where the channel surfaces or dives in. A natural place to begin or end tracing the line with attention."
    },
    "uz": {
     "name": "Quduq nuqtasi (jing)",
     "short": "Meridianning barmoq uchidagi chekka nuqtasi: kanal shu yerda yuzaga chiqadi yoki yuzadan ketadi. Chiziqni diqqat bilan bosib o'tishni shu yerdan boshlash yoki tugatish qulay."
    },
    "kz": {
     "name": "Құдық нүктесі (цзин)",
     "short": "Меридианның саусақ ұшындағы шеткі нүктесі: арна осы жерде бетке шығады немесе беттен кетеді. Сызықты зейінмен жүріп өтуді осы жерден бастау не аяқтау ыңғайлы."
    }
   },
   "color_hint": "#7FDBFF"
  },
  "ying_spring": {
   "i18n": {
    "ru": {
     "name": "Точка-родник (ин)",
     "short": "Вторая из пяти точек-шу, обычно у основания пальца. Поток здесь только набирает силу, как родник."
    },
    "en": {
     "name": "Ying-spring point",
     "short": "The second of the five shu points, usually near the base of a finger or toe. The flow is just gathering strength here, like a spring."
    },
    "uz": {
     "name": "Buloq nuqtasi (ying)",
     "short": "Besh shu-nuqtaning ikkinchisi, odatda barmoq asosida joylashgan. Oqim bu yerda buloqdek endi kuch yig'a boshlaydi."
    },
    "kz": {
     "name": "Бұлақ нүктесі (ин)",
     "short": "Бес шу-нүктенің екіншісі, әдетте саусақ түбінде орналасады. Ағын мұнда бұлақтай енді ғана күш жинайды."
    }
   },
   "color_hint": "#4FC3F7"
  },
  "shu_stream": {
   "i18n": {
    "ru": {
     "name": "Точка-поток (шу)",
     "short": "Третья из пяти точек-шу: поток становится заметнее, как ручей. На инь-меридианах эта точка одновременно ЮАНЬ-пункт."
    },
    "en": {
     "name": "Shu-stream point",
     "short": "The third of the five shu points: the flow becomes more noticeable, like a stream. On yin meridians it is also the yuan point."
    },
    "uz": {
     "name": "Soy nuqtasi (shu)",
     "short": "Besh shu-nuqtaning uchinchisi: oqim soydek sezilarliroq bo'ladi. Yin meridianlarida bu nuqta bir vaqtning o'zida Yuan-nuqta hamdir."
    },
    "kz": {
     "name": "Жылға нүктесі (шу)",
     "short": "Бес шу-нүктенің үшіншісі: ағын жылғадай байқалатын болады. Инь меридиандарында бұл нүкте әрі Юань-нүкте болып табылады."
    }
   },
   "color_hint": "#29A3D9"
  },
  "jing_river": {
   "i18n": {
    "ru": {
     "name": "Точка-река (цзин)",
     "short": "Четвёртая из пяти точек-шу, у запястья или лодыжки либо немного выше. Поток здесь широкий и ровный, как река."
    },
    "en": {
     "name": "Jing-river point",
     "short": "The fourth of the five shu points, at or a little above the wrist or ankle. The flow here is broad and steady, like a river."
    },
    "uz": {
     "name": "Daryo nuqtasi (jing)",
     "short": "Besh shu-nuqtaning to'rtinchisi, bilak yoki to'piq sohasida yoxud undan biroz yuqorida. Oqim bu yerda daryodek keng va bir tekis."
    },
    "kz": {
     "name": "Өзен нүктесі (цзин)",
     "short": "Бес шу-нүктенің төртіншісі, білек не тобық тұсында немесе одан сәл жоғары. Ағын мұнда өзендей кең әрі бірқалыпты."
    }
   },
   "color_hint": "#1F7FB8"
  },
  "he_sea": {
   "i18n": {
    "ru": {
     "name": "Точка-море (хэ)",
     "short": "Пятая из пяти точек-шу, у локтя или колена. Здесь поток уходит вглубь, как река, впадающая в море."
    },
    "en": {
     "name": "He-sea point",
     "short": "The fifth of the five shu points, at the elbow or knee. Here the flow goes deep, like a river entering the sea."
    },
    "uz": {
     "name": "Dengiz nuqtasi (he)",
     "short": "Besh shu-nuqtaning beshinchisi, tirsak yoki tizza sohasida. Bu yerda oqim dengizga quyilayotgan daryodek chuqurga ketadi."
    },
    "kz": {
     "name": "Теңіз нүктесі (хэ)",
     "short": "Бес шу-нүктенің бесіншісі, шынтақ не тізе тұсында. Мұнда ағын теңізге құятын өзендей тереңге кетеді."
    }
   },
   "color_hint": "#145A86"
  },
  "mu": {
   "i18n": {
    "ru": {
     "name": "МУ-пункт",
     "short": "Точка на груди или животе, которую традиция связывает с органом одного из меридианов. Через неё удобно направить внимание внутрь тела спереди."
    },
    "en": {
     "name": "Mu (front-collecting) point",
     "short": "A point on the chest or abdomen that tradition links with the organ of one meridian. It is a convenient way to bring attention inward from the front of the body."
    },
    "uz": {
     "name": "Mu-nuqta (old yig'uvchi)",
     "short": "Ko'krak yoki qorindagi nuqta, an'ana uni biror meridian a'zosi bilan bog'laydi. U orqali diqqatni tananing old tomonidan ichkariga yo'naltirish qulay."
    },
    "kz": {
     "name": "Му-нүкте (алдыңғы жинаушы)",
     "short": "Кеудедегі не іштегі нүкте, дәстүр оны бір меридианның мүшесімен байланыстырады. Ол арқылы зейінді дененің алдыңғы жағынан ішке бағыттау ыңғайлы."
    }
   },
   "color_hint": "#E84A8A"
  },
  "back_shu": {
   "i18n": {
    "ru": {
     "name": "ШУ-пункт спины",
     "short": "Точка на спине рядом с позвоночником, которую традиция связывает с органом одного из меридианов. Помогает почувствовать, как этот меридиан отзывается в спине."
    },
    "en": {
     "name": "Back-shu point",
     "short": "A point on the back beside the spine, traditionally linked with the organ of one meridian. It helps you notice how that meridian echoes in the back."
    },
    "uz": {
     "name": "Orqa shu-nuqtasi",
     "short": "Umurtqa pog'onasi yonidagi orqa nuqtasi, an'anaga ko'ra biror meridian a'zosi bilan bog'langan. U shu meridian orqada qanday aks etishini sezishga yordam beradi."
    },
    "kz": {
     "name": "Арқа шу-нүктесі",
     "short": "Омыртқа жанындағы арқа нүктесі, дәстүр бойынша бір меридианның мүшесімен байланысты. Ол сол меридианның арқада қалай білінетінін сезуге көмектеседі."
    }
   },
   "color_hint": "#A0522D"
  },
  "confluent": {
   "i18n": {
    "ru": {
     "name": "Ключевая точка чудесного сосуда",
     "short": "По традиции через эту точку открывается один из восьми чудесных сосудов. На карте рядом подписано, какой именно."
    },
    "en": {
     "name": "Confluent (opening) point",
     "short": "Tradition holds that one of the eight extraordinary vessels opens through this point. The map labels which one."
    },
    "uz": {
     "name": "Ajoyib tomirning kalit nuqtasi",
     "short": "An'anaga ko'ra sakkiz ajoyib tomirdan biri shu nuqta orqali ochiladi. Xaritada qaysi biri ekanligi yozib qo'yilgan."
    },
    "kz": {
     "name": "Ғажайып тамырдың кілт нүктесі",
     "short": "Дәстүр бойынша сегіз ғажайып тамырдың бірі осы нүкте арқылы ашылады. Картада қайсысы екені жазылған."
    }
   },
   "color_hint": "#2ECC71"
  },
  "hui": {
   "i18n": {
    "ru": {
     "name": "Точка влияния (хуэй)",
     "short": "Одна из восьми точек влияния: каждую традиция связывает со своей тканью или субстанцией — ци, кровью, сухожилиями, костями и другими. На карте подписано, с какой."
    },
    "en": {
     "name": "Hui (influential) point",
     "short": "One of the eight influential points, each traditionally linked with a tissue or substance: qi, blood, sinews, bones and others. The map shows which one."
    },
    "uz": {
     "name": "Ta'sir nuqtasi (hui)",
     "short": "Sakkiz ta'sir nuqtasidan biri: an'ana har birini o'z to'qimasi yoki moddasi bilan bog'laydi — qi, qon, paylar, suyaklar va boshqalar. Xaritada qaysi biri ekanligi ko'rsatilgan."
    },
    "kz": {
     "name": "Ықпал нүктесі (хуэй)",
     "short": "Сегіз ықпал нүктесінің бірі: дәстүр әрқайсысын өз тінімен не затымен байланыстырады — ци, қан, сіңірлер, сүйектер және басқалар. Картада қайсысы екені көрсетілген."
    }
   },
   "color_hint": "#F1C40F"
  },
  "lower_he": {
   "i18n": {
    "ru": {
     "name": "Нижняя точка-море",
     "short": "Точка на ноге, которую традиция связывает с одним из ян-органов: желудком, кишечником, мочевым пузырём, желчным пузырём или тремя обогревателями. На карте подписано, с каким."
    },
    "en": {
     "name": "Lower he-sea point",
     "short": "A point on the leg that tradition links with one of the yang organs: stomach, intestines, bladder, gallbladder or triple burner. The map shows which one."
    },
    "uz": {
     "name": "Pastki dengiz nuqtasi",
     "short": "Oyoqdagi nuqta, an'ana uni yang a'zolaridan biri bilan bog'laydi: oshqozon, ichak, siydik pufagi, o't pufagi yoki uch isituvchi. Xaritada qaysi biri ekanligi ko'rsatilgan."
    },
    "kz": {
     "name": "Төменгі теңіз нүктесі",
     "short": "Аяқтағы нүкте, дәстүр оны ян мүшелерінің бірімен байланыстырады: асқазан, ішек, қуық, өт қабы не үш жылытқыш. Картада қайсысы екені көрсетілген."
    }
   },
   "color_hint": "#16A085"
  },
  "crossing": {
   "i18n": {
    "ru": {
     "name": "Точка пересечения",
     "short": "Здесь сходятся два меридиана или больше. На карте видно, какие линии встречаются в этой точке, и внимание касается сразу нескольких каналов."
    },
    "en": {
     "name": "Crossing point",
     "short": "Two or more meridians meet here. The map shows which lines cross at this point, so attention touches several channels at once."
    },
    "uz": {
     "name": "Kesishish nuqtasi",
     "short": "Bu yerda ikki yoki undan ortiq meridian uchrashadi. Xaritada qaysi chiziqlar kesishishi ko'rinadi, diqqat bir vaqtning o'zida bir nechta kanalga tegadi."
    },
    "kz": {
     "name": "Қиылысу нүктесі",
     "short": "Мұнда екі не одан көп меридиан тоғысады. Картада қай сызықтар қиылысатыны көрінеді, зейін бір мезетте бірнеше арнаға тиеді."
    }
   },
   "color_hint": "#FF66CC"
  }
 },
